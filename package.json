{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node12 --format=cjs --external:bcryptjs --external:sqlite3 --external:sharp --external:mysql2 --external:fluent-ffmpeg --external:@ffmpeg-installer/ffmpeg --external:@aws-sdk/client-s3 --banner:js=\"var _mod=require('module');var _origReq=_mod.prototype.require;_mod.prototype.require=function(id){if(typeof id==='string'&&id.startsWith('node:'))id=id.slice(5);if(id==='fs/promises')return require('fs').promises;if(id==='stream/promises')return require('stream').promises;return _origReq.call(this,id);};\" --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
